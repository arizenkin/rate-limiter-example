{
  "name": "rate-limiter",
  "version": "1.0.0",
  "description": "In-memory HTTP rate limiter service (sliding window counter, hexagonal architecture)",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22 <25"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "jest --coverage",
    "bench": "tsx bench/run.ts --mode latency",
    "bench:capacity": "tsx bench/run.ts --mode capacity",
    "bench:hot": "tsx bench/run.ts --mode hot",
    "bench:publish": "tsx bench/publish.ts",
    "gen-key": "tsx tools/gen-api-key.ts",
    "docs:api": "tsx tools/serve-api-docs.ts"
  },
  "dependencies": {
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/autocannon": "7.12.7",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "autocannon": "8.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
